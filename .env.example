# Weather Application Environment Configuration
#
# By default, this app uses Open-Meteo API.
# Open-Meteo delivers accurate, real-time weather data worldwide with NO API key required.
#
# If you prefer to use OpenWeatherMap:
# 1. Sign up at https://openweathermap.org/api and copy your API key.
# 2. Set VITE_WEATHER_PROVIDER=openweathermap
# 3. Paste your key into VITE_OPENWEATHER_API_KEY below.

VITE_WEATHER_PROVIDER=open-meteo
VITE_OPENWEATHER_API_KEY=
